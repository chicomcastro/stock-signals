{
  "name": "stock-signals",
  "version": "1.1.0",
  "description": "Análise técnica de ações da B3, BDRs, cripto e FX com sinais automáticos (Golden/Death Cross, RSI, MACD).",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node tools/sync-vendor.js && nodemon src/index.js --watch src --watch public",
    "build": "node tools/sync-vendor.js",
    "vercel-build": "node tools/sync-vendor.js",
    "postinstall": "node tools/sync-vendor.js || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tools/sync-vendor.js && playwright test",
    "test:e2e:install": "playwright install chromium --with-deps",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "fixture:generate": "node tools/generate-fixture.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stocks",
    "b3",
    "technical-analysis",
    "macd",
    "rsi",
    "golden-cross",
    "trading",
    "finance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chicomcastro/stock-signals.git"
  },
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^2.13.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.6",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  }
}
